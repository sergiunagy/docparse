# OpenAI API key (project-scoped). See PLAN.md §6. Never commit the real value.
OPENAI_API_KEY=sk-...

# Model under test. Default quality anchor is gpt-5-mini (PLAN.md §7).
# Alternatives to benchmark: gpt-5-nano, gpt-5, gpt-4o-mini (legacy).
OPENAI_MODEL=gpt-5-mini

# Reasoning models only (gpt-5*). Keep minimal for this extraction/summary task.
OPENAI_REASONING_EFFORT=minimal

# Image fidelity lever: low | high. Default high for dense legal fine print.
OPENAI_IMAGE_DETAIL=high

# Page render resolution for PyMuPDF -> PNG.
PDF_RENDER_DPI=150

# Optional custom endpoint (local swap path: Ollama/vLLM speak Chat Completions).
# OPENAI_BASE_URL=https://api.openai.com/v1
