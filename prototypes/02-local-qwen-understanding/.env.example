# Local Ollama endpoint (OpenAI-compatible surface). See PLAN.md §6.
# The key is an ignored dummy string — there is no auth on local Ollama.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# Model under test. See PLAN.md §7.
# NOTE: prefer the *Instruct* build of qwen3-vl. The plain qwen3-vl:8b is the
# *Thinking* build (RENDERER qwen3-vl-thinking) and its reasoning trace CANNOT be
# disabled on this Ollama build (think:false, /no_think, reasoning_effort all
# ignored) — it starves the output budget and roughly doubles latency.
# Alternatives to benchmark: qwen2.5vl:7b, qwen2.5vl:7b-q8_0 (quality-vs-VRAM probe).
OPENAI_MODEL=qwen3-vl:8b-instruct

# Structured-output strategy (PLAN.md §1.2 / §3):
#   json_schema   — try proto 02's client.beta...parse(response_format=Model) as-is
#   ollama_format — pass the JSON schema via extra_body={"format": ...} (Ollama native)
#   auto          — try json_schema first, fall back to ollama_format on failure
OLLAMA_STRUCTURED_MODE=auto

# Page render resolution for PyMuPDF -> PNG.
PDF_RENDER_DPI=150

# Server-side runtime config (set on `ollama serve`, NOT per-request — PLAN.md §6.5).
# Logged for attribution only; main.py cannot change these via the /v1 request.
#   OLLAMA_CONTEXT_LENGTH — required; the 4096 default hard-fails multi-page image
#                           prompts with exceed_context_size_error (~4.1k tokens/page).
#   OLLAMA_FLASH_ATTENTION — enable flash attention (needed for the q8_0 KV cache below).
#   OLLAMA_KV_CACHE_TYPE   — quantise the KV cache to fit the 12 GB card.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
